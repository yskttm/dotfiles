{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "0.25"
  },
  "permissions": {
    "allow": [
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(gh search *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm ls *)",
      "Bash(npx *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(git reset *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * +*)",
      "Bash(rm -rf *)",
      "Bash(wget *)",
      "Bash(curl *)",
      "Read(//**/.env*)",
      "Read(//**/*credentials*.json)",
      "Read(//**/*credentials*.yml)",
      "Read(//**/*credentials*.yaml)",
      "Read(//**/*secret*.json)",
      "Read(//**/*secret*.yml)",
      "Read(//**/*secret*.yaml)",
      "Read(//**/*.secret)",
      "Read(//**/service-account*.json)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.token)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.jks)",
      "Read(//**/*.keystore)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/id_ecdsa)",
      "Read(//**/.netrc)",
      "Read(//**/config/*yml.enc*)",
      "Read(//**/config/credentials/*yml.enc*)",
      "Read(//**/.aws/**)",
      "Read(//**/.ssh/**)",
      "Read(//**/secrets/**)",
      "Edit(//**/.env*)",
      "Edit(//**/*credentials*.json)",
      "Edit(//**/*credentials*.yml)",
      "Edit(//**/*credentials*.yaml)",
      "Edit(//**/*secret*.json)",
      "Edit(//**/*secret*.yml)",
      "Edit(//**/*secret*.yaml)",
      "Edit(//**/*.secret)",
      "Edit(//**/service-account*.json)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.key)",
      "Edit(//**/*.token)",
      "Edit(//**/*.p12)",
      "Edit(//**/*.pfx)",
      "Edit(//**/*.jks)",
      "Edit(//**/*.keystore)",
      "Edit(//**/id_rsa)",
      "Edit(//**/id_ed25519)",
      "Edit(//**/id_ecdsa)",
      "Edit(//**/.netrc)",
      "Edit(//**/config/*yml.enc*)",
      "Edit(//**/config/credentials/*yml.enc*)",
      "Edit(//**/.aws/**)",
      "Edit(//**/.ssh/**)",
      "Edit(//**/secrets/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git branch -D *)",
      "Bash(git stash *)",
      "Bash(npm ci *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/log_bash.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "aws-core@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "rubygems.org",
        "*.rubygems.org",
        "*.cloudfront.net",
        "registry.npmjs.org",
        "hub.docker.com",
        "registry-1.docker.io"
      ]
    },
    "excludedCommands": [
      "docker",
      "docker-compose",
      "docker compose"
    ]
  },
  "advisorModel": "opus",
  "showThinkingSummaries": true,
  "theme": "auto",
  "autoScrollEnabled": true
}
